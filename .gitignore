# Per-machine Claude Code permissions: local commands, paths and cloud IDs.
.claude/settings.local.json

# Gradle output of local native modules (regenerated on every build)
pulso/modules/*/android/build/

# Capturas de la tienda: borradores con datos de cuentas reales
/store/play/screenshots/

# HyperFrames: renders and snapshots are build outputs (web copies live in server/public/media)
/videos/*/renders/
/videos/*/snapshots/
/videos/*/.hyperframes/
/videos/*/.thumbnails/
/videos/*/.media/
