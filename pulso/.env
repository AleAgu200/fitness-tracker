EXPO_PUBLIC_SERVER_URL=https://pulsofitness.tech
#EXPO_PUBLIC_SERVER_URL=http://100.64.100.6:3000 

# RevenueCat public SDK keys (safe in the client; the secret key is server-only).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=test_jezlnOugLwHCPHYnzwpyaqJIeOl
EXPO_PUBLIC_REVENUECAT_IOS_KEY=test_jezlnOugLwHCPHYnzwpyaqJIeOl

# Google Sign-In (client IDs are public; no secret belongs here). The Web client
# ID is the ID-token audience the server checks (GOOGLE_CLIENT_IDS there).
# Android also needs its Android client (package + SHA-1) in the same Google
# Cloud project, but its ID is never used in code. Empty = button hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only; also sets the URL scheme in app.config.ts. Empty = hidden on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
