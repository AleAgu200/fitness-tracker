{
  "expo": {
    "name": "PULSO",
    "slug": "pulso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulso",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lalomaster.pulso"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withShortCxxPath",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#E8FF59",
          "defaultChannel": "pulso-general"
        }
      ],
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PulsoEntrenoWidget",
              "displayName": "Pulso · Entreno",
              "description": "Ejercicio actual, siguiente y descanso.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemLarge"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60c5fb56-176a-4054-823c-89297c5e4ef8"
      }
    }
  }
}
